# ============================================================================
# University Ecosystem — Docker Environment Configuration (EXAMPLE)
# ============================================================================
# Copy this file to .env.docker and replace ALL placeholder values.
# NEVER commit .env.docker — it is gitignored via .env.* pattern.
#
# Credentials rotation guide:
#   Spotify:  https://developer.spotify.com/dashboard → Regenerate client secret
#   VAPID:    openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#             openssl ec -in vapid.pem -pubout | base64 -w0
#   DB pass:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS
POSTGRES_DB=university

# Application secret — MUST be 64+ cryptographically random characters
SECRET_KEY=CHANGE_ME_use_python_secrets_token_urlsafe_64

# JWT configuration — start-docker.ps1 creates this private key locally
ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=.secrets/jwt_rs256.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS

# Infrastructure credentials used by docker-compose.full.yml
ELASTIC_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS
NATS_USER=app
NATS_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS
REDIS_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS
# docker-compose.full.yml overrides this with revocation-redis:6379. Keeping the
# variable explicit documents that revocations never belong in the cache Redis.
REVOCATION_REDIS_URL=redis://:${REDIS_PASSWORD}@revocation-redis:6379/0
SPICEDB_PRESHARED_KEY=CHANGE_ME_AT_LEAST_32_CHARS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS

# Authenticated backend metrics scraping. start-docker.ps1 generates and keeps
# the password synchronized with Prometheus automatically.
ENABLE_METRICS_ENDPOINT=true
METRICS_BASIC_AUTH_USERNAME=metrics_scraper
METRICS_BASIC_AUTH_PASSWORD=CHANGE_ME_AT_LEAST_32_CHARS

# Signed image proxy URLs. Both values must be hexadecimal; the launcher
# generates 32 random bytes (64 hex characters) for each.
IMGPROXY_KEY=CHANGE_ME_64_HEX_CHARACTERS
IMGPROXY_SALT=CHANGE_ME_64_HEX_CHARACTERS
IMGPROXY_BASE_URL=http://localhost/imgproxy

# Environment
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=false

# Required for production-like email MFA. Inject real 32-byte base64url keys
# from the deployment secret store; never commit generated values.
MFA_EMAIL_OTP_HMAC_KEYS=CHANGE_ME_ID:CHANGE_ME_BASE64URL_32_BYTES
MFA_EMAIL_OTP_ACTIVE_HMAC_KEY_ID=CHANGE_ME_ID
MFA_EMAIL_DELIVERY_KEKS=CHANGE_ME_ID:CHANGE_ME_BASE64URL_32_BYTES
MFA_EMAIL_DELIVERY_ACTIVE_KEK_ID=CHANGE_ME_ID
MFA_TRUSTED_DEVICE_HMAC_KEYS=CHANGE_ME_ID:CHANGE_ME_BASE64URL_32_BYTES
MFA_TRUSTED_DEVICE_ACTIVE_HMAC_KEY_ID=CHANGE_ME_ID

# Push Notifications (VAPID) — generate with web-push or openssl
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY_BASE64URL
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY_BASE64URL
VAPID_SUBJECT=mailto:admin@example.com

# Spotify Configuration — register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=CHANGE_ME_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=CHANGE_ME_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_SCOPES=user-read-email user-read-private user-top-read user-read-currently-playing user-read-playback-state

# Independent application secrets. The launcher generates and synchronizes all
# of these automatically. SPOTIFY_TOKEN_SECRET must be a 32-byte Fernet key.
CSRF_HMAC_SECRET=CHANGE_ME_python_secrets_token_urlsafe_32
INTERNAL_HMAC_SECRET=CHANGE_ME_python_secrets_token_urlsafe_32
SPOTIFY_TOKEN_SECRET=CHANGE_ME_FERNET_KEY
SPOTIFY_OAUTH_STATE_SECRET=CHANGE_ME_python_secrets_token_urlsafe_32

# ws-hub Internal API Secret — used to authenticate cache-invalidation calls from backend.
# AUDIT-INFRA-02: empty value not allowed — ws-hub fails to start without this.
# Generate with: openssl rand -hex 32
WS_HUB_INTERNAL_SECRET=CHANGE_ME_openssl_rand_hex_32

# RZ-W10-11: Idempotency HMAC secret — prevents attackers from enumerating
# idempotency keys by observing the Idempotency-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEMPOTENCY_HMAC_SECRET=CHANGE_ME_python_secrets_token_urlsafe_32

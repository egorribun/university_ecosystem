# ============================================================================
# University Ecosystem Platform — Environment Variables
# ============================================================================
# Copy this file to .env and replace ALL placeholder values before running.
# NEVER commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
# SECURITY: Generate a strong password (min 32 chars, alphanumeric + symbols)
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_32CHARS
POSTGRES_DB=university

# Connection string for the application (Docker Compose internal network):
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# For migrations (uses psycopg sync driver):
# DATABASE_URL_SYNC=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ----------------------------------------------------------------------------
# REDIS (REQUIRED)
# ----------------------------------------------------------------------------
# SECURITY: Generate a strong password
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_32CHARS

# ----------------------------------------------------------------------------
# ELASTICSEARCH (REQUIRED — used when SearchService is active)
# ----------------------------------------------------------------------------
# Password for the built-in 'elastic' superuser (xpack.security.enabled=true).
# Must match ELASTIC_PASSWORD in docker-compose.full.yml.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ELASTIC_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_32CHARS
# RZ-12: MUST be https:// in production/staging — enforced at startup.
# http:// is only acceptable on a local developer machine without TLS termination.
# Change to: https://elasticsearch:9200 before deploying.
# TD-W16-04: Default to https:// — only use http:// on local dev without TLS.
ELASTICSEARCH_URL=https://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=${ELASTIC_PASSWORD}

# ----------------------------------------------------------------------------
# MESSAGE BUS — NATS (REQUIRED)
# ----------------------------------------------------------------------------
# MOD-W10-04: Credentials are passed as separate env vars so the NATS URL
# never contains an embedded password (URLs are logged by the NATS client on
# reconnect and may appear in /proc/<pid>/environ on Linux).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
NATS_URL=nats://nats:4222
NATS_USER=CHANGE_ME_nats_user
NATS_PASSWORD=CHANGE_ME_python_secrets_token_urlsafe_24

# ----------------------------------------------------------------------------
# OBJECT STORAGE — MINIO (REQUIRED)
# ----------------------------------------------------------------------------
# SECURITY: Generate strong credentials, do NOT use defaults
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_32CHARS
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=uploads
# RZ-12: Set to 'true' in staging/production — enforced by Settings at startup.
# 'false' is allowed ONLY on a local machine without TLS-terminating reverse proxy.
# Change to: MINIO_SECURE=true before deploying.
MINIO_SECURE=false

# ----------------------------------------------------------------------------
# AUTHORIZATION — SPICEDB (REQUIRED)
# ----------------------------------------------------------------------------
# SECURITY: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPICEDB_PRESHARED_KEY=CHANGE_ME_GENERATE_32_BYTE_PRESHARED_KEY
SPICEDB_HOST=spicedb
SPICEDB_PORT=50051

# ----------------------------------------------------------------------------
# APPLICATION SECRETS (REQUIRED)
# ----------------------------------------------------------------------------
# SECURITY: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_64_BYTE_SECRET_KEY

# RZ-01: A dedicated HMAC secret for password-reset and email-change tokens.
# Must be set explicitly in staging/production — the application will raise a
# RuntimeError at startup if this is unset in a non-development environment.
# Kept separate from SECRET_KEY so JWT rotation does not invalidate in-flight
# reset tokens (OWASP A02 — Cryptographic Failures).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
TOKEN_HMAC_SECRET=CHANGE_ME_GENERATE_64_BYTE_TOKEN_HMAC_SECRET

# Signing key(s) for cryptographic HMAC integrity checks on audit log entries.
# Supports comma-separated list for key rotation (first key is primary).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUDIT_LOG_SECRET=CHANGE_ME_GENERATE_64_BYTE_AUDIT_LOG_SECRET

# Independent HMAC keys for browser CSRF tokens, trusted gateway identity
# headers, and chat idempotency keys. Never reuse SECRET_KEY for these domains.
CSRF_HMAC_SECRET=CHANGE_ME_GENERATE_32_BYTE_CSRF_HMAC_SECRET
INTERNAL_HMAC_SECRET=CHANGE_ME_GENERATE_32_BYTE_INTERNAL_HMAC_SECRET
IDEMPOTENCY_HMAC_SECRET=CHANGE_ME_GENERATE_32_BYTE_IDEMPOTENCY_HMAC_SECRET

# JWT signing algorithm.
# MUST be RS256 for ALL non-local environments (staging, qa, production).
# HS256 (symmetric) is ONLY acceptable for ENVIRONMENT=development on a local machine.
# RS256 separates signing (private key, secret) from verification (public key, shareable).
# Generate a key pair locally:
#   openssl genrsa -out .secrets/jwt_rs256.pem 4096
#   openssl rsa -in .secrets/jwt_rs256.pem -pubout -out .secrets/jwt_rs256_pub.pem
ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=.secrets/jwt_rs256.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
# For key rotation: JWT_SIGNING_KEYS="v1:kid1:secret1,v2:kid2:secret2" with JWT_ACTIVE_KID="v2"
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=


# ----------------------------------------------------------------------------
# FRONTEND / CORS
# ----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
VITE_BACKEND_ORIGIN=http://localhost:8000

# ----------------------------------------------------------------------------
# TRUSTED HOSTS & PROXIES
# ----------------------------------------------------------------------------
# Comma-separated list of allowed Host header values.
# Use "*" to allow all (NOT for production).
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated list of trusted reverse-proxy IPs (for X-Forwarded-For)
TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_BACKEND=memory   # memory | redis
RATE_LIMIT_STORAGE_URI=memory://    # redis://host:6379/0 when backend=redis

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=noreply@example.com

# ----------------------------------------------------------------------------
# SPOTIFY INTEGRATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_SCOPES=user-read-email user-read-private user-top-read user-read-currently-playing user-read-playback-state

# RZ-5 (audit 2026-03-05): REQUIRED in staging/production.
# Independent Fernet encryption key for stored Spotify OAuth tokens.
# Decoupled from SECRET_KEY so JWT rotation does not silently invalidate
# all connected Spotify accounts. Runtime will raise at startup if unset in prod.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_TOKEN_SECRET=CHANGE_ME_GENERATE_FERNET_KEY
# Dedicated signer for the short-lived OAuth state token. Keeping it separate
# prevents cross-protocol token confusion with encrypted Spotify credentials.
SPOTIFY_OAUTH_STATE_SECRET=CHANGE_ME_GENERATE_32_BYTE_SPOTIFY_OAUTH_STATE_SECRET

# ----------------------------------------------------------------------------
# PASSWORD POLICY
# ----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=200
PASSWORD_MIN_CHARACTER_CLASSES=3
PASSWORD_ZXCVBN_MIN_SCORE=1
# Enable Have I Been Pwned breach check (requires outbound HTTPS to api.pwnedpasswords.com)
PASSWORD_HIBP_CHECK_ENABLED=false
PASSWORD_HIBP_TIMEOUT_SECONDS=5

# ----------------------------------------------------------------------------
# MFA
# ----------------------------------------------------------------------------
MFA_ENABLED=false
MFA_TOTP_ISSUER=University Ecosystem
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5

# ----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (OPTIONAL — required for web push)
# ----------------------------------------------------------------------------
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------------------------
# IMAGE PROXY (OPTIONAL — generate if using imgproxy)
# ----------------------------------------------------------------------------
# Generate each secret with: openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_BASE_URL=http://localhost/imgproxy

# ----------------------------------------------------------------------------
# AUTHORIZATION (SpiceDB)
# TD-W16-04: Duplicate SPICEDB_PRESHARED_KEY removed — see line 72 for primary.
# ----------------------------------------------------------------------------
# RZ-9: SpiceDB → PostgreSQL connection SSL mode.
# MUST be 'require' (or 'verify-full') in staging and production.
# 'disable' is only acceptable on a single-machine local dev setup.
SPICEDB_PG_SSLMODE=require

# ----------------------------------------------------------------------------
# OBSERVABILITY (OPTIONAL)
# ----------------------------------------------------------------------------
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
ENABLE_PROFILING=false
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040

# Grafana admin credentials (GF_SECURITY_ADMIN_PASSWORD is REQUIRED in docker-compose.full.yml)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_32CHARS

# Backend /metrics is protected with HTTP Basic auth. The Docker launcher
# generates and synchronizes this password for the local observability stack.
ENABLE_METRICS_ENDPOINT=false
METRICS_BASIC_AUTH_USERNAME=metrics_scraper
METRICS_BASIC_AUTH_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_48CHARS

# ----------------------------------------------------------------------------
# HTTP SECURITY HEADERS
# ----------------------------------------------------------------------------
# RZ-15 (audit 2026-03-05): Set to 'true' when a reverse proxy (Caddy, nginx)
# is terminating TLS and already emits Strict-Transport-Security.
# Prevents duplicate HSTS headers from the Python ASGI middleware layer.
SECURITY_HSTS_BEHIND_PROXY=false

# RZ-13 (audit 2026-03-05): MUST be 'false' in production.
# If 'true', file uploads are accepted WITHOUT malware scanning when ClamAV
# is unavailable. Startup will raise a RuntimeError if set to true in prod.
# Only set to 'true' on a local machine without ClamAV installed.
EVENT_FILE_SCANNER_ALLOW_ON_UNAVAILABLE=false

# ----------------------------------------------------------------------------
# OBJECT STORAGE — S3-COMPATIBLE (aioboto3, PERF-7 audit 2026-03-05)
# ----------------------------------------------------------------------------
# STORAGE_BACKEND=s3          # 's3' | 'minio' | 'static'
# STORAGE_S3_BUCKET=uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME
# STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME
# STORAGE_S3_ENDPOINT_URL=http://minio:9000   # leave blank for real AWS S3
# STORAGE_S3_BASE_URL=https://cdn.example.com # public URL prefix for file URIs

# ----------------------------------------------------------------------------
# DEVELOPMENT ONLY (remove or change in production)
# ----------------------------------------------------------------------------
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=false

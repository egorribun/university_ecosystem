# University Ecosystem - Caddy Configuration
# Automatic HTTPS reverse proxy with compression and security headers

{
    # Global options
    email admin@example.com

    # Development mode - disable HTTPS for local testing
    # Remove this block in production
    auto_https off
}

# Development: localhost
:80 {
    # Health check endpoint for Docker
    handle /health {
        respond "OK" 200
    }

    # Compression
    encode zstd gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "0"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # API Gateway (Go)
    handle /api/* {
        reverse_proxy gateway:8080
    }

    # GraphQL endpoint (via Gateway)
    handle /graphql* {
        reverse_proxy gateway:8080
    }

    # WebSocket Hub (Go)
    handle /ws/* {
        reverse_proxy ws-hub:8081
    }

    # Static files from backend
    handle /static/* {
        reverse_proxy backend:8000
    }

    # MinIO presigned URLs (optional direct access)
    handle /storage/* {
        uri strip_prefix /storage
        reverse_proxy minio:9000
    }

    # Wave 131 SW4 — Service worker MUST come from same origin and MUST NOT
    # be cached (browsers re-check on every navigation). The Node SSR runtime
    # serves /sw.js from dist/client/sw.js; Caddy adds the Service-Worker-Allowed
    # header so the SW can claim a wider scope than its file location.
    handle /sw.js {
        reverse_proxy frontend:3000
        header Service-Worker-Allowed "/"
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    }

    # Wave 131 SW4 — Phase 4 deploy infrastructure: default handle now points
    # at the Node SSR runtime (frontend:3000) instead of the prior nginx
    # static-serve (frontend:8080). `health_uri /healthz` probes the W131 SW2
    # fast path so Caddy stops proxying to a dead upstream automatically.
    handle {
        reverse_proxy frontend:3000 {
            health_uri /healthz
            health_interval 10s
            health_timeout 5s
        }
    }
}

# Production configuration (uncomment and customize)

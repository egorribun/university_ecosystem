# syntax=docker/dockerfile:1.7
FROM python:3.13.1-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN --mount=type=cache,id=apt-lists-test,target=/var/lib/apt/lists \
    --mount=type=cache,id=apt-cache-test,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --shell /bin/bash app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

COPY pyproject.toml uv.lock ./

# Install dependencies into virtualenv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

COPY . .
RUN chown -R app:app /app

USER app

CMD ["pytest", "tests/", "-v", "--tb=short", "-x", "--ignore=tests/performance"]

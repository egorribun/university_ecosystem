# syntax=docker/dockerfile:1.7
FROM python:3.13.1-slim-bookworm@sha256:031ebf3cde9f3719d2db385233bcb18df5162038e9cda20e64e08f49f4b47a2f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN --mount=type=cache,id=apt-lists-test,target=/var/lib/apt/lists \
    --mount=type=cache,id=apt-cache-test,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --shell /bin/bash app

# Install Rust toolchain (required by maturin to build pyo3-sanitizer and rust_ext)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

# Install uv
# LOW-W19: pin to same version used in CI (reusable-backend-tests uses setup-uv v7.6.0)
# Use --locked flag on uv sync to enforce lockfile consistency regardless of uv version
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Copy workspace member manifests + sources so uv can resolve the workspace before sync
COPY native/rust_ext/pyproject.toml native/rust_ext/Cargo.toml native/rust_ext/Cargo.lock native/rust_ext/
COPY native/rust_ext/src native/rust_ext/src
COPY crates/pyo3-sanitizer/pyproject.toml crates/pyo3-sanitizer/Cargo.toml crates/pyo3-sanitizer/Cargo.lock crates/pyo3-sanitizer/
COPY crates/pyo3-sanitizer/src crates/pyo3-sanitizer/src

COPY pyproject.toml uv.lock ./

# Install dependencies into virtualenv (builds Rust extensions via maturin)
# LOW-W19: --locked enforces lockfile integrity, matching CI behaviour
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cargo/registry \
    uv sync --frozen --locked

COPY . .
RUN chown -R app:app /app

USER app

CMD ["pytest", "tests/", "-v", "--tb=short", "-x", "--ignore=tests/performance"]

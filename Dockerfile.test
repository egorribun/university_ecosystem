# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
#checkov:skip=CKV_DOCKER_2:this disposable test runner is health-checked by the CI job, not deployed as a service.
FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN --mount=type=cache,id=apt-lists-test,target=/var/lib/apt/lists \
    --mount=type=cache,id=apt-cache-test,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl clang libclang-rt-14-dev git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --shell /bin/bash --create-home app
# MOD-30-05: Install Rust toolchain from official Docker image instead of
# curl|sh (supply chain risk — executing unversioned script from internet).
# Pin to a specific Rust version for reproducible builds.
COPY --from=rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa /usr/local/rustup /usr/local/rustup
COPY --from=rust:1.99.0-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME="/usr/local/rustup" \
    CARGO_HOME="/usr/local/cargo" \
    PATH="/usr/local/cargo/bin:$PATH"

# Python quality contracts execute real Go benchmarks in this full test runner.
# Match the isolated benchmark compiler and prevent implicit toolchain downloads.
COPY --from=docker.io/library/golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c /usr/local/go /usr/local/go
ENV GOTOOLCHAIN="local" \
    PATH="/usr/local/go/bin:$PATH"

# Install uv
# Pin to the exact version required by pyproject.toml so ``uv sync --frozen``
# cannot fail before the disposable test image has installed its dependencies.
COPY --from=ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Copy workspace member manifests + sources so uv can resolve the workspace before sync
COPY native/rust_ext/pyproject.toml native/rust_ext/Cargo.toml native/rust_ext/Cargo.lock native/rust_ext/
COPY native/rust_ext/src native/rust_ext/src
COPY native/rust_ext/benches native/rust_ext/benches

COPY pyproject.toml uv.lock ./

# Install dependencies into virtualenv (builds Rust extensions via maturin)
# LOW-W19: --locked enforces lockfile integrity, matching CI behaviour
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cargo/registry \
    uv sync --frozen

COPY . .
RUN chown -R app:app /app

USER app

CMD ["pytest", "tests/", "-v", "--tb=short", "-x", "--ignore=tests/performance"]

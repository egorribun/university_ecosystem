# syntax=docker/dockerfile:1.12
#checkov:skip=CKV_DOCKER_2:this disposable test runner is health-checked by the CI job, not deployed as a service.
FROM python:3.14-slim-bookworm@sha256:4ff4b92a68355dbdb52584ab3391dff8d371a61d4e063468bfd0130e3189c6d9

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN --mount=type=cache,id=apt-lists-test,target=/var/lib/apt/lists \
    --mount=type=cache,id=apt-cache-test,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl clang libclang-rt-14-dev \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --shell /bin/bash --create-home app
# MOD-30-05: Install Rust toolchain from official Docker image instead of
# curl|sh (supply chain risk — executing unversioned script from internet).
# Pin to a specific Rust version for reproducible builds.
COPY --from=rust:1.94.1-slim-bookworm@sha256:5ae2d2ef9875c9c2407bf9b5678e6375304f7ecf8ea46b23e403a5690ec357ec /usr/local/rustup /usr/local/rustup
COPY --from=rust:1.94.1-slim-bookworm@sha256:5ae2d2ef9875c9c2407bf9b5678e6375304f7ecf8ea46b23e403a5690ec357ec /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME="/usr/local/rustup" \
    CARGO_HOME="/usr/local/cargo" \
    PATH="/usr/local/cargo/bin:$PATH"

# Install uv
# Pin to the exact version required by pyproject.toml so ``uv sync --frozen``
# cannot fail before the disposable test image has installed its dependencies.
COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:5c3ab83183a73c5d319a77009eb425b60d5bb937f339fb7876788ebf567baf48 /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Copy workspace member manifests + sources so uv can resolve the workspace before sync
COPY native/rust_ext/pyproject.toml native/rust_ext/Cargo.toml native/rust_ext/Cargo.lock native/rust_ext/
COPY native/rust_ext/src native/rust_ext/src
COPY native/rust_ext/benches native/rust_ext/benches
COPY crates/pyo3-sanitizer/pyproject.toml crates/pyo3-sanitizer/Cargo.toml crates/pyo3-sanitizer/Cargo.lock crates/pyo3-sanitizer/
COPY crates/pyo3-sanitizer/src crates/pyo3-sanitizer/src
COPY crates/pyo3-sanitizer/benches crates/pyo3-sanitizer/benches

COPY pyproject.toml uv.lock ./

# Install dependencies into virtualenv (builds Rust extensions via maturin)
# LOW-W19: --locked enforces lockfile integrity, matching CI behaviour
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cargo/registry \
    uv sync --frozen

COPY . .
RUN chown -R app:app /app

USER app

CMD ["pytest", "tests/", "-v", "--tb=short", "-x", "--ignore=tests/performance"]

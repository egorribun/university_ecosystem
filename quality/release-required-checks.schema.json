{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-aware release-critical GitHub check policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 2 },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_event",
        "github_ref",
        "github_repository",
        "required_checks"
      ],
      "properties": {
        "github_event": { "type": "string", "minLength": 1 },
        "github_ref": { "type": "string", "minLength": 1 },
        "github_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "workflow_path",
        "category",
        "allowed_conclusions",
        "rationale"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "category": {
          "enum": ["aggregate", "quality_manifest", "security", "contracts"]
        },
        "allowed_conclusions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["success", "skipped"] }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "safe_to_skip": { "type": "boolean" },
        "skip_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed_conclusions": { "contains": { "const": "skipped" } }
            },
            "required": ["allowed_conclusions"]
          },
          "then": {
            "required": ["safe_to_skip", "skip_reason"],
            "properties": { "safe_to_skip": { "const": true } }
          }
        }
      ]
    }
  }
}

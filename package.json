{
  "name": "university-ecosystem-root",
  "private": true,
  "description": "Root management for University Ecosystem",
  "scripts": {
    "release": "semantic-release",
    "test:release-toolchain": "npm --prefix tools/npm-cli-shim test && node --test scripts/tests/*.test.mjs && npm --version",
    "test:semantic-release-micromatch-compat": "node --test tools/semantic-release-micromatch-compat/compat.test.cjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "runner-npm-cli-bridge": "file:tools/npm-cli-shim",
    "semantic-release": "^25.0.9",
    "micromatch": "file:tools/semantic-release-micromatch-compat"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "^6.28.0"
    },
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.4",
    "micromatch": "$micromatch",
    "npm": "$runner-npm-cli-bridge",
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "handlebars": "4.7.10"
  }
}

# Sample environment for local Compose usage.
# Copy to root/.env and replace any values that differ in your setup.

POSTGRES_USER=university
POSTGRES_PASSWORD=local_dev_pg_password_ChangeMe_123456
POSTGRES_DB=university
# Compose already falls back to this URL when DATABASE_URL is unset; keeping it here
# makes the default explicit for docker compose config.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# A development-only placeholder path; production deployments should inject a real secret file.
POSTGRES_PASSWORD_FILE=./root/.secrets/postgres_password

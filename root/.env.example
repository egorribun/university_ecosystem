# WARNING: Development template only. Copy to root/.env for local testing and replace
# every secret with a strong value stored outside version control. Never commit
# a populated root/.env file.

# ----- Core backend settings -----
POSTGRES_USER=university
POSTGRES_DB=university
# Prefer POSTGRES_PASSWORD_FILE with a private file path when using Docker Compose.
# Keep `POSTGRES_PASSWORD` and `DATABASE_URL` in sync with the contents of the password file.
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=./root/.secrets/postgres_password
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----- CORS / links -----
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
ENABLE_STRICT_SECURITY_HEADERS=false
SECURITY_CSP_REPORT_ONLY=true
ENABLE_COOP=false
ENABLE_COEP=false
COEP_VALUE=credentialless
ENABLE_CORP=false
CORP_VALUE=same-site

STATIC_DIR=app/static
ENABLE_RESPONSE_COMPRESSION=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
TRUSTED_HOSTS=localhost,127.0.0.1

# ----- File uploads -----
EVENT_FILE_SCANNER_ENABLED=false
EVENT_FILE_SCANNER_MAX_SIZE_MB=25
EVENT_FILE_SCANNER_MAX_DURATION_SEC=10

# ----- Mail -----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SECURITY=none
MAIL_FROM=info@example.test

# ----- Third-party integrations -----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
SPOTIFY_SCOPES=user-read-email user-read-private user-top-read user-read-currently-playing user-read-playback-state

# ----- Web push -----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.test

# ----- Observability -----
ENABLE_OTEL=false
OTEL_SERVICE_NAME=university-ecosystem
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLER_RATIO=1.0
ENABLE_OTEL_METRICS=true
ENABLE_OTEL_LOGS=true

# ----- Error tracking -----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# ----- Cache -----
CACHE_ENABLED=false
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# ----- Rate limiting -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SENSITIVE=5/minute
RATE_LIMIT_STORAGE_BACKEND=memory
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_HEADERS_ENABLED=true

# ----- Cleanup jobs -----
SESSION_CLEANUP_INTERVAL_SECONDS=900
MFA_CHALLENGE_CLEANUP_INTERVAL_SECONDS=600
MFA_CHALLENGE_CLEANUP_GRACE_PERIOD_SECONDS=600
PASSWORD_RESET_CLEANUP_INTERVAL_SECONDS=3600
PASSWORD_RESET_CLEANUP_RETENTION_MINUTES=45
PASSWORD_RESET_MAX_ACTIVE_TOKENS=1
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
STORIES_CLEANUP_ENABLED=true
STORIES_RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# ----- Metrics -----
ENABLE_METRICS_ENDPOINT=false
METRICS_BASIC_AUTH_USERNAME=
METRICS_BASIC_AUTH_PASSWORD=
METRICS_ALLOWLIST=

# ----- Multi-factor authentication (TOTP only) -----
MFA_ENABLED=false
MFA_TOTP_ISSUER=University Ecosystem
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_STEP_UP_TTL_SECONDS=300
MFA_TOTP_ATTEMPT_LIMIT=5

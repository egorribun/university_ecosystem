{
  "id": "/?source=pwa",
  "name": "GUU Ecosystem — everything in one place",
  "short_name": "GUU Ecosystem",
  "description": "Profile, schedule, news, and the campus map stay available even when you're offline.",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "start_url": "/?source=pwa",
  "scope": "/",
  "orientation": "portrait-primary",
  "theme_color": "#0b63f4",
  "background_color": "#f4f8fd",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": ["education", "productivity"],
  "shortcuts": [
    {
      "name": "Schedule",
      "description": "Open today's class schedule",
      "url": "/schedule",
      "icons": [
        {
          "src": "/maskable-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "News",
      "description": "Read the latest campus updates",
      "url": "/news",
      "icons": [
        {
          "src": "/maskable-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Campus map",
      "description": "Find buildings and routes on the GUU map",
      "url": "/map",
      "icons": [
        {
          "src": "/maskable-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/guu_logo.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/maskable-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/guu_logo.png",
      "sizes": "512x512",

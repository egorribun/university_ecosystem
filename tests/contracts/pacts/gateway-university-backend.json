{
  "consumer": {
    "name": "gateway"
  },
  "interactions": [
    {
      "description": "a backend liveness request",
      "pending": false,
      "providerStates": [
        {
          "name": "Backend process is alive"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/health/live"
      },
      "response": {
        "body": {
          "content": {
            "status": "alive"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ],
          "content-type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json(?:;.*)?$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "university-backend"
  }
}
{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        }
      }
    },
    "applicationSecrets": {
      "type": "object",
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "required": [
            "mfaEmailOtpHMACKeys",
            "mfaEmailOtpActiveHMACKeyId",
            "mfaEmailDeliveryKEKs",
            "mfaEmailDeliveryActiveKEKId",
            "mfaTrustedDeviceHMACKeys",
            "mfaTrustedDeviceActiveHMACKeyId"
          ],
          "properties": {
            "mfaEmailOtpHMACKeys": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "mfaEmailOtpActiveHMACKeyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "mfaEmailDeliveryKEKs": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "mfaEmailDeliveryActiveKEKId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "mfaTrustedDeviceHMACKeys": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "mfaTrustedDeviceActiveHMACKeyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
    },
    "deploymentContract": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "mfaEmailOtpHMACKeys": {"type": "string"},
            "mfaEmailOtpActiveHMACKeyId": {"type": "string"},
            "mfaEmailDeliveryKEKs": {"type": "string"},
            "mfaEmailDeliveryActiveKEKId": {"type": "string"},
            "mfaTrustedDeviceHMACKeys": {"type": "string"},
            "mfaTrustedDeviceActiveHMACKeyId": {"type": "string"}
          }
        }
      }
    }
  }
}

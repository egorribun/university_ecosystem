{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "University Ecosystem cache Redis input contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "image",
    "networkPolicy",
    "auth",
    "master",
    "commonConfiguration",
    "metrics"
  ],
  "properties": {
    "enabled": {
      "const": true
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "registry": {
          "const": "docker.io"
        },
        "repository": {
          "const": "redis"
        },
        "tag": {
          "const": "7.4.11-alpine"
        },
        "digest": {
          "type": "string",
          "pattern": "^(REQUIRED_SHA256_DIGEST|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "const": "Always"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowExternal", "allowExternalEgress"],
      "properties": {
        "enabled": {
          "const": true
        },
        "allowExternal": {
          "const": false
        },
        "allowExternalEgress": {
          "const": false
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingSecret", "existingSecretPasswordKey"],
      "properties": {
        "enabled": {
          "const": true
        },
        "existingSecret": {
          "const": "redis-credentials"
        },
        "existingSecretPasswordKey": {
          "const": "redis-password"
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources",
        "aclInitResources",
        "persistence",
        "podSecurityContext",
        "containerSecurityContext"
      ],
      "properties": {
        "replicas": {
          "const": 1
        },
        "resources": {
          "const": {
            "requests": {
              "cpu": "250m",
              "memory": "512Mi"
            },
            "limits": {
              "cpu": "1",
              "memory": "2Gi"
            }
          }
        },
        "aclInitResources": {
          "const": {
            "requests": {
              "cpu": "50m",
              "memory": "32Mi"
            },
            "limits": {
              "cpu": "250m",
              "memory": "128Mi"
            }
          }
        },
        "persistence": {
          "const": {
            "enabled": true,
            "size": "8Gi"
          }
        },
        "podSecurityContext": {
          "const": {
            "fsGroup": 1001,
            "fsGroupChangePolicy": "Always",
            "runAsNonRoot": true,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          }
        },
        "containerSecurityContext": {
          "const": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": ["ALL"]
            },
            "readOnlyRootFilesystem": true,
            "runAsGroup": 1001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          }
        }
      }
    },
    "commonConfiguration": {
      "const": "dir /data\nmaxmemory 1536mb\nmaxmemory-policy volatile-lru\nsave \"\"\nappendonly no\nrename-command FLUSHDB \"\"\nrename-command FLUSHALL \"\""
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "passwordFileInitImage", "resources"],
      "properties": {
        "enabled": {
          "const": true
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "registry": {
              "const": "docker.io"
            },
            "repository": {
              "const": "oliver006/redis_exporter"
            },
            "tag": {
              "const": "v1.93.0"
            },
            "digest": {
              "type": "string",
              "pattern": "^(REQUIRED_SHA256_DIGEST|sha256:[0-9a-f]{64})$"
            },
            "pullPolicy": {
              "const": "Always"
            }
          }
        },
        "passwordFileInitImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": {
              "type": "string",
              "pattern": "^(|REQUIRED_SHA256_DIGEST|sha256:[0-9a-f]{64})$"
            },
            "pullPolicy": { "const": "Always" }
          }
        },
        "resources": {
          "const": {
            "requests": {
              "cpu": "50m",
              "memory": "32Mi"
            },
            "limits": {
              "cpu": "100m",
              "memory": "64Mi"
            }
          }
        }
      }
    },
    "architecture": {
      "const": "standalone"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "jwtIssuer": {
          "type": "string",
          "minLength": 1
        },
        "imageRegistry": {
          "type": "string"
        },
        "imageTag": {
          "type": "string"
        },
        "backendImageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultStorageClass": {
          "type": "string"
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowInsecureImages": {
              "type": "boolean"
            }
          }
        },
        "compatibility": {
          "type": "object"
        }
      }
    }
  }
}

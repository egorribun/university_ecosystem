{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "University Ecosystem revocation-store input contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationReleaseName", "redis"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backendImageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "applicationReleaseName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullnameOverride",
        "commonLabels",
        "auth",
        "image",
        "master",
        "commonConfiguration",
        "networkPolicy",
        "metrics"
      ],
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        },
        "commonLabels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "university-ecosystem.io/revocation-store-for",
            "app.kubernetes.io/instance"
          ],
          "properties": {
            "university-ecosystem.io/revocation-store-for": {
              "type": "string",
              "minLength": 1
            },
            "app.kubernetes.io/instance": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "existingSecretPasswordKey"],
          "properties": {
            "existingSecret": {
              "const": "revocation-redis-credentials"
            },
            "existingSecretPasswordKey": {
              "const": "revocation-redis-password"
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "registry": {
              "const": "docker.io"
            },
            "repository": {
              "const": "redis"
            },
            "tag": {
              "const": "7.4.11-alpine"
            },
            "digest": {
              "type": "string",
              "pattern": "^(REQUIRED_SHA256_DIGEST|sha256:[0-9a-f]{64})$"
            },
            "pullPolicy": {
              "const": "Always"
            }
          }
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "revisionHistoryLimit",
            "terminationGracePeriodSeconds",
            "updateStrategy",
            "resources",
            "persistence",
            "persistentVolumeClaimRetentionPolicy",
            "pdb",
            "disableCommands"
          ],
          "properties": {
            "count": {
              "const": 1
            },
            "revisionHistoryLimit": {
              "const": 10
            },
            "terminationGracePeriodSeconds": {
              "const": 30
            },
            "updateStrategy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "RollingUpdate"
                }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": {
                      "const": "100m"
                    },
                    "memory": {
                      "const": "128Mi"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": {
                      "const": "500m"
                    },
                    "memory": {
                      "const": "512Mi"
                    }
                  }
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "size"],
              "properties": {
                "enabled": {
                  "const": true
                },
                "size": {
                  "const": "2Gi"
                }
              }
            },
            "persistentVolumeClaimRetentionPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "whenScaled", "whenDeleted"],
              "properties": {
                "enabled": {
                  "const": true
                },
                "whenScaled": {
                  "const": "Retain"
                },
                "whenDeleted": {
                  "const": "Retain"
                }
              }
            },
            "pdb": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minAvailable"],
              "properties": {
                "minAvailable": {
                  "const": 1
                }
              }
            },
            "disableCommands": {
              "const": [
                "ACL",
                "CONFIG",
                "FLUSHDB",
                "FLUSHALL",
                "FUNCTION",
                "MIGRATE",
                "MODULE",
                "MONITOR",
                "REPLICAOF",
                "SLAVEOF",
                "SHUTDOWN"
              ]
            }
          }
        },
        "commonConfiguration": {
          "const": "maxmemory 384mb\nmaxmemory-policy noeviction\nsave 60 1\nappendonly yes\nappendfsync everysec"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "monitoringNamespace"],
          "properties": {
            "enabled": {
              "const": true
            },
            "monitoringNamespace": {
              "const": "monitoring"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "image", "port", "resources"],
          "properties": {
            "enabled": {
              "const": true
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "registry",
                "repository",
                "tag",
                "digest",
                "pullPolicy"
              ],
              "properties": {
                "registry": {
                  "const": "docker.io"
                },
                "repository": {
                  "const": "oliver006/redis_exporter"
                },
                "tag": {
                  "const": "v1.93.0"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(REQUIRED_SHA256_DIGEST|sha256:[0-9a-f]{64})$"
                },
                "pullPolicy": {
                  "const": "Always"
                }
              }
            },
            "port": {
              "const": 9121
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "limits"],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": {
                      "const": "25m"
                    },
                    "memory": {
                      "const": "24Mi"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": {
                      "const": "100m"
                    },
                    "memory": {
                      "const": "64Mi"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

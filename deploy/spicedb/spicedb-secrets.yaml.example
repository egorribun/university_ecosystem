#   refreshInterval: 1h
#   secretStoreRef:
#     name: vault-backend
#     kind: ClusterSecretStore
#   target:
#     name: spicedb-secrets
#     creationPolicy: Owner
#   data:
#     - secretKey: grpc-preshared-key
#       remoteRef:
#         key: secret/spicedb
#         property: grpc-preshared-key
#     - secretKey: datastore-uri
#       remoteRef:
#         key: secret/spicedb
#         property: datastore-uri

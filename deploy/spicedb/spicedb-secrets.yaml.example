# SpiceDB Secrets Example Configuration
#
# IMPORTANT: This is an EXAMPLE file. Do NOT commit actual secrets to version control.
#
# For production deployment:
# 1. Copy this file to spicedb-secrets.yaml
# 2. Replace placeholder values with actual secrets
# 3. Apply with: kubectl apply -f spicedb-secrets.yaml
# 4. Ensure spicedb-secrets.yaml is in .gitignore
#
# Alternatively, use a secrets management solution:
# - Kubernetes External Secrets Operator
# - HashiCorp Vault with Vault Agent Injector
# - AWS Secrets Manager with CSI driver
# - Azure Key Vault with CSI driver
# - Google Secret Manager with CSI driver

apiVersion: v1
kind: Secret
metadata:
  name: spicedb-secrets
  namespace: university-ecosystem
  labels:
    app: spicedb
type: Opaque
stringData:
  # Pre-shared key for gRPC authentication
  # Generate with: openssl rand -hex 32
  grpc-preshared-key: "REPLACE_WITH_GENERATED_PRESHARED_KEY"

  # PostgreSQL connection string
  # Format: postgres://user:password@host:port/database?sslmode=require
  #
  # Connection string recommendations:
  # - Always use sslmode=require or sslmode=verify-full in production
  # - Use dedicated database user with minimal required permissions
  # - Consider using IAM authentication for cloud-managed databases
  #
  # Required PostgreSQL permissions for SpiceDB user:
  # - CREATE TABLE (for migrations)
  # - SELECT, INSERT, UPDATE, DELETE on SpiceDB tables
  #
  # Example for managed PostgreSQL services:
  # - AWS RDS: postgres://spicedb_user:password@mydb.xxx.rds.amazonaws.com:5432/spicedb?sslmode=require
  # - Google Cloud SQL: postgres://spicedb_user:password@/spicedb?host=/cloudsql/project:region:instance&sslmode=disable
  # - Azure Database: postgres://spicedb_user@server:password@server.postgres.database.azure.com:5432/spicedb?sslmode=require
  datastore-uri: "postgres://spicedb_user:REPLACE_WITH_DB_PASSWORD@postgres-spicedb:5432/spicedb?sslmode=require"

# ---
# Alternative: Using External Secrets Operator
#
# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: spicedb-secrets
#   namespace: university-ecosystem

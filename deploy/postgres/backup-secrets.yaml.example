# PostgreSQL Backup Secrets Example
#
# IMPORTANT: This is an EXAMPLE file. Do NOT commit actual secrets.
#
# For production:
# 1. Copy to backup-secrets.yaml
# 2. Replace placeholder values with actual credentials
# 3. Apply: kubectl apply -f backup-secrets.yaml
#
# Alternative: Use External Secrets Operator, HashiCorp Vault, or cloud-native secrets

apiVersion: v1
kind: Secret
metadata:
  name: postgres-backup-secrets
  namespace: university-ecosystem
  labels:
    app: postgres-backup
type: Opaque
stringData:
  # PostgreSQL connection
  host: "postgres-primary.university-ecosystem.svc.cluster.local"
  username: "backup_user"
  password: "REPLACE_WITH_BACKUP_USER_PASSWORD"

  # S3/MinIO configuration
  s3-bucket: "university-ecosystem-backups"
  aws-access-key-id: "REPLACE_WITH_ACCESS_KEY"
  aws-secret-access-key: "REPLACE_WITH_SECRET_KEY"
  aws-region: "us-east-1"

  # For MinIO, also set AWS_ENDPOINT_URL in the CronJob:
  # - name: AWS_ENDPOINT_URL
  #   value: "https://minio.university-ecosystem.svc:9000"

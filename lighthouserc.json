{
  "ci": {
    "collect": {
      "staticDistDir": "./root/frontend/dist",
      "numberOfRuns": 2,
      "isSinglePageApplication": true,
      "url": [
        "/index.html",
        "/dashboard"
      ],
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:pwa": [
          "warn",
          {
            "minScore": 0.6
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./root/frontend/.lighthouseci",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.%%EXTENSION%%"
    }
  }
}

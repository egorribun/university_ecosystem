{
  "name": "University Ecosystem",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "mounts": [
    "source=devcontainer-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=devcontainer-npm-cache,target=/home/vscode/.npm,type=volume"
  ],
  "postCreateCommand": "pip install -r root/requirements.txt && pip install -r root/requirements-dev.txt && npm ci --prefix root/frontend",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "basic",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "tasks": [
        {
          "label": "Run API",
          "type": "shell",
          "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --env-file root/.env",
          "options": {
            "cwd": "${workspaceFolder}/root"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        },
        {
          "label": "Run Web",
          "type": "shell",
          "command": "npm run dev -- --host 0.0.0.0 --port 5173",
          "options": {
            "cwd": "${workspaceFolder}/root/frontend"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        },
        {
          "label": "Test All",
          "type": "shell",
          "command": "pytest && npm --prefix frontend test",
          "options": {
            "cwd": "${workspaceFolder}/root"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        }
      ]
    }
  },
  "forwardPorts": [8000, 5173],
  "remoteUser": "vscode"
}

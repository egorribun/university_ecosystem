{
  "name": "University Ecosystem",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "mounts": [
    "source=devcontainer-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=devcontainer-npm-cache,target=/home/vscode/.npm,type=volume"
  ],
  "postCreateCommand": "make install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "basic",
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "tasks": [
        {
          "label": "Run API",
          "type": "shell",
          "command": "make backend-serve",
          "options": {
            "cwd": "${workspaceFolder}"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        },
        {
          "label": "Run Web",
          "type": "shell",
          "command": "make frontend-dev",
          "options": {
            "cwd": "${workspaceFolder}"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        },
        {
          "label": "Test All",
          "type": "shell",
          "command": "make test",
          "options": {
            "cwd": "${workspaceFolder}"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        },
        {
          "label": "Lint",
          "type": "shell",
          "command": "make lint",
          "options": {
            "cwd": "${workspaceFolder}"
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated"
          },
          "problemMatcher": []
        }
      ]
    }
  },
  "forwardPorts": [8000, 5173],
  "remoteUser": "vscode"
}

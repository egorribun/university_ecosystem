# syntax=docker/dockerfile:1.7
FROM golang:1.26.6-alpine3.24@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df

# Install Protobuf compiler and Python
RUN apk add --no-cache \
    protobuf \
    python3 \
    py3-pip \
    ca-certificates

# Build all Go-based generators from checksum-verified modules with the patched
# repository toolchain. This avoids importing stale Go runtimes from upstream
# release binaries into the code-generation image.
ARG BUF_VERSION="v1.72.0"
ENV GOTOOLCHAIN=local

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/usr/local/bin go install \
      "github.com/bufbuild/buf/cmd/buf@${BUF_VERSION}" && \
    GOBIN=/usr/local/bin go install \
      google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 && \
    GOBIN=/usr/local/bin go install \
      google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2

WORKDIR /workspace

# The image is used for code generation only; keep the generated workspace
# writable while ensuring the default process cannot run as root.
RUN addgroup -S -g 10001 protogen \
    && adduser -S -D -u 10001 -G protogen -h /home/protogen -s /sbin/nologin protogen \
    && chown -R protogen:protogen /workspace
USER protogen

# This is a short-lived code-generation tool image, never a deployed service.
#checkov:skip=CKV_DOCKER_2:the image is not a long-running service.
#checkov:skip=CKV_DOCKER_3:the image is a build tool and runs only in CI.

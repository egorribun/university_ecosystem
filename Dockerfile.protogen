# syntax=docker/dockerfile:1.7
FROM golang:1.24.0-bookworm

# Install Protobuf compiler and Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Buf Binary
RUN curl -L -o /usr/local/bin/buf "https://github.com/bufbuild/buf/releases/download/v1.50.0/buf-$(uname -s)-$(uname -m)" && \
    chmod +x /usr/local/bin/buf

# Install Go Plugins with pinned versions
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.5
RUN go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

# Add Go bin to PATH
ENV PATH="/go/bin:${PATH}"

WORKDIR /workspace

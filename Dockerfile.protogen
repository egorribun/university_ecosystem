# syntax=docker/dockerfile:1.7
FROM golang:1.24.0-bookworm@sha256:b970e6d47c09fdd34179acef5c4fecaf6410f0b597a759733b3cbea04b4e604a

# Install Protobuf compiler and Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Buf Binary — pinned to v1.50.0 with verified SHA256 integrity check.
# Digest sourced from: https://github.com/bufbuild/buf/releases/download/v1.50.0/sha256.txt
# Architecture: Linux-x86_64 (CI runners are amd64). Update both when upgrading buf.
ARG BUF_VERSION="v1.50.0"

RUN <<'EOF'
set -eux
buf_sha256="154ea883ce098eac4fa106ff9ee4e4964bb97f809dd8ec9c34a432b466ce1494" # pragma: allowlist secret
curl -fsSL -o /usr/local/bin/buf \
    "https://github.com/bufbuild/buf/releases/download/${BUF_VERSION}/buf-Linux-x86_64"
echo "${buf_sha256}  /usr/local/bin/buf" | sha256sum -c -
chmod +x /usr/local/bin/buf
EOF

# Install Go Plugins with pinned versions
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.5
RUN go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

# Add Go bin to PATH
ENV PATH="/go/bin:${PATH}"

WORKDIR /workspace

# The image is used for code generation only; keep the generated workspace
# writable while ensuring the default process cannot run as root.
RUN groupadd --system --gid 10001 protogen \
    && useradd --system --uid 10001 --gid protogen --create-home --shell /usr/sbin/nologin protogen \
    && chown -R protogen:protogen /workspace
USER protogen

# This is a short-lived code-generation tool image, never a deployed service.
#checkov:skip=CKV_DOCKER_2:the image is not a long-running service.
#checkov:skip=CKV_DOCKER_3:the image is a build tool and runs only in CI.

# Caddyfile — HTTP/3 (QUIC) edge reverse proxy for university-ecosystem.
#
# Caddy manages TLS certificates automatically via Let's Encrypt (ACME).
# HTTP/3 (QUIC/UDP) is advertised via the Alt-Svc response header.
# The Python backend stays on plain HTTP/1.1 internally — QUIC terminates here.
#
# For local development (self-signed / no domain), set the environment variable:
#   ACME_EMAIL=      (empty or omitted → Caddy uses self-signed locally)
# For production, set:
#   ACME_EMAIL=you@example.com
#   PUBLIC_HOSTNAME=your.domain.tld
{
	# Enable all three protocol versions at the server level.
	# h3 (QUIC) is enabled automatically when UDP 443 is exposed.
	servers {
		protocols h1 h2 h3
	}

	# Auto-HTTPS certificate management email (required for ACME production).
	# In dev environments without a real domain, Caddy falls back to self-signed.
	email {$ACME_EMAIL}
}

# Main HTTPS site — matches the public hostname or falls back to :443.
{$PUBLIC_HOSTNAME} {
	# --- WebSocket upgrade rate limit (MED-05) --------------------------------
	# Throttle WebSocket connection creation to 10 upgrades / minute per IP.
	# This is a network-layer guard before the request reaches the Python backend,
	# which applies its own /ws rate limit as defense-in-depth.
	# Requires the caddy-ratelimit plugin (see services/caddy/Dockerfile).
	@ws_upgrade {
		path /ws/*
		header Connection *Upgrade*
	}
	rate_limit @ws_upgrade {
		zone ws_upgrades {
			key {http.request.remote.host}
			events 10
			window 1m
		}
	}

	# Edge-local liveness: confirms Caddy can serve requests without depending
	# on any upstream application container.
	handle /healthz {
		respond "OK" 200
	}

	# --- Multi-service routing (Wave 131 SW4 Phase 4 deploy infrastructure) -
	# Pre-W131: a single root-level reverse_proxy sent ALL traffic to backend
	# — internal-only configuration that never had a frontend service. Phase
	# 4 introduces a Node SSR frontend runtime, so prefixes now route
	# explicitly: /api/*, /graphql*, /ws/* go to backend services; /sw.js
	# plus the default handle go to frontend:3000.
	# Public key discovery bypasses the gateway so edge and service clients can
	# refresh the backend's RS256 key without an authentication dependency.
	handle /.well-known/* {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy gateway:8080 {
			header_up X-Real-IP {http.request.remote}
			header_up X-Forwarded-Proto https
			health_uri /health
			health_interval 10s
			health_timeout 5s
		}
	}

	handle /graphql* {
		reverse_proxy gateway:8080 {
			header_up X-Real-IP {http.request.remote}
			header_up X-Forwarded-Proto https
		}
	}

	# Ticket issuance is an ordinary authenticated HTTP request handled by the
	# gateway. It must not fall through to the WebSocket server.
	handle /ws/ticket {
		reverse_proxy gateway:8080
	}

	# The browser-facing path is /ws/chat, while ws-hub registers the exact /ws
	# endpoint. Preserve the query string (including the one-time ticket) while
	# rewriting only the path.
	handle /ws/chat* {
		rewrite * /ws
		reverse_proxy ws-hub:8081 {
			header_up X-Real-IP {http.request.remote}
			header_up X-Forwarded-Proto https
		}
	}

	# /ws/* routes to ws-hub (port 8081) — `@ws_upgrade` rate_limit above
	# already throttles WS upgrade attempts before they reach this block.
	handle /ws/* {
		reverse_proxy ws-hub:8081 {
			header_up X-Real-IP {http.request.remote}
			header_up X-Forwarded-Proto https
		}
	}

	# Backend-served static assets (uploads, generated thumbnails, etc.).
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Signed image-processing URLs. handle_path strips /imgproxy before
	# forwarding because the backend signs the path understood by imgproxy.
	handle_path /imgproxy/* {
		reverse_proxy imgproxy:8080
	}

	# Optional same-origin access to MinIO objects.
	handle /storage/* {
		uri strip_prefix /storage
		reverse_proxy minio:9000
	}

	# Service worker — must be on same origin, no cache, with broad scope.
	handle /sw.js {
		reverse_proxy frontend:3000
		header Service-Worker-Allowed "/"
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	}

	# The default deployment has one frontend service. Any future canary must
	# provide its additional upstream through a temporary operator-managed
	# config; the checked-in baseline must remain independently deployable.
	handle {
		reverse_proxy frontend:3000 {
			health_uri /healthz
			health_interval 10s
			# A cold authenticated SSR route can synchronously load a large route
			# graph before the Node event loop services this probe. Keep the probe
			# above that bounded cold-start window so Caddy does not evict the only
			# healthy upstream and return a spurious 503 to the next request.
			health_timeout 20s
			fail_duration 30s
			unhealthy_status 5xx
			header_up X-Real-IP {http.request.remote}
			header_up X-Forwarded-Proto https
		}
	}

	# --- HTTP/3 advertisement header --------------------------------------
	# Browsers use this to upgrade future connections to QUIC.
	# ma=2592000 = 30-day max-age (standard recommendation).
	header Alt-Svc `h3=":443"; ma=2592000`

	# --- Security hardening -----------------------------------------------
	# HSTS: tell browsers to always use HTTPS for this domain (1 year).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# Prevent Caddy from leaking its version in the Server header.
	header -Server

	# --- Logging -----------------------------------------------------------
	log {
		output stderr
		format json
		level INFO
	}
}

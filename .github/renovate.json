{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "packageRules": [
    {
      "description": "SHA-pin all GitHub Actions and auto-group weekly PRs",
      "matchDepTypes": ["action"],
      "pinDigests": true,
      "automerge": false,
      "groupName": "GitHub Actions"
    },
    {
      "description": "MOD-2026-01 (audit 2026-03-15): Pin all Docker images to SHA-256 digest. Mutable tags allow upstream registry to replace an image without changing the tag string (supply-chain attack). SLSA Level 2 requires immutable references. Renovate will open PRs to update both tag and digest together.",
      "matchManagers": ["docker-compose", "dockerfile"],
      "pinDigests": true,
      "automerge": false,
      "labels": ["security", "dependencies", "docker"]
    },
    {
      "description": "Keep security-sensitive Docker images on manual review schedule",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": [
        "minio/minio",
        "authzed/spicedb",
        "temporalio/server",
        "temporalio/ui"
      ],
      "automerge": false,
      "labels": ["security", "dependencies"]
    },
    {
      "description": "Auto-merge patch updates for frontend npm packages",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "groupName": "Frontend patch updates"
    },
    {
      "description": "RZ-22-02: Security-critical Python packages — manual review required. Auto-merge disabled to prevent supply-chain attacks via compromised patch releases (xz-utils attack vector).",
      "matchManagers": ["uv"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "cryptography",
        "pyjwt",
        "bcrypt",
        "argon2-cffi",
        "pyotp",
        "webauthn",
        "python-jose"
      ],
      "automerge": false,
      "labels": ["security", "manual-review-required"]
    },
    {
      "description": "Group all other Python dependency updates (manual review)",
      "matchManagers": ["uv"],
      "matchUpdateTypes": ["patch"],
      "automerge": false,
      "groupName": "Python dependencies"
    },
    {
      "description": "Track Go toolchain minor versions (manual review)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "automerge": false,
      "labels": ["go-toolchain", "dependencies"]
    },
    {
      "description": "MOD-06 (audit Wave 12): Auto-merge Go module patch updates weekly. Supply-chain attacks via go.sum hash bypass are neutralised by automated PRs with SBOM diffs. Minor/major updates require manual review.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06 (audit Wave 12): Group Go module minor/major updates for manual review.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Go dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06 (audit Wave 12): Auto-merge Rust (Cargo) patch updates. Cargo.lock pins exact versions; Renovate opens PRs when a patched version is available.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Rust dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["rust", "dependencies"]
    },
    {
      "description": "MOD-06: Group Rust minor/major updates for manual review.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Rust dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["rust", "dependencies"]
    },
    {
      "description": "Flag all security vulnerability alerts with the security label",
      "matchPackagePatterns": ["*"],
      "vulnerabilityAlerts": {
        "labels": ["security"],
        "assignees": []
      }
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["after 3am and before 7am on Monday"],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}

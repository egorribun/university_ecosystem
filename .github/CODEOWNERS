# CODEOWNERS — required reviewers for sensitive files
# Syntax: <pattern> <owner> [<owner>...]
# Owners are notified when matching files are changed in a PR.
# See: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# AUDIT-INFRA-06 (audit 2026-03-15): .secrets.baseline is a detect-secrets
# suppression list. Any change must be reviewed by the repository owner to
# prevent contributors from hiding newly-committed secrets in the baseline.
.secrets.baseline @egorribun

# CI/CD workflow changes affect the entire security posture of the project.
.github/workflows/ @egorribun

# Semgrep suppression entries are security policy, not a generic lint
# configuration.  Keep ledger changes under the same owner review boundary.
security/semgrep-suppression-policy.json @egorribun

# Performance decision tools affect required merge contexts; changes need the
# same owner review as the workflows that invoke them.
scripts/quality/check_go_benchmark_budget.py @egorribun
scripts/quality/compare_paired_benchmarks.py @egorribun
scripts/quality/capture_isolated_benchmarks.py @egorribun
containers/quality/Dockerfile.performance-rust @egorribun

# Infrastructure secrets and compose files contain credentials and network config.
docker-compose*.yml @egorribun
.env.docker.example @egorribun

# Kubernetes manifests control cluster security: RBAC, NetworkPolicy, pod security.
k8s/ @egorribun

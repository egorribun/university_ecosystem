# TD-09 (audit 2026-03-06): NATS credentials via config file, not CLI args.
# Credentials in --user/--pass are visible in `docker ps` and /proc/<pid>/cmdline.
# envsubst substitutes $NATS_USER / $NATS_PASSWORD from container env at startup.
port: 4222
http_port: 8222

jetstream {
  store_dir: /data
  max_file: 10GB
  max_mem: 512MB
}

authorization {
  user: $NATS_USER
  password: $NATS_PASSWORD
}

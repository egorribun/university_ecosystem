# TD-09 (audit 2026-03-06): credentials are loaded from container environment and rendered as quoted NATS strings.
# Compose startup replaces each marker once; credentials never enter process arguments.
port: 4222
http_port: 8222

jetstream {
  store_dir: /data
  max_file: 10GB
  max_mem: 512MB
}

authorization {
  user: @NATS_USER@
  password: @NATS_PASSWORD@
}

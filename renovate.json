{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "MOD-21-05 (audit 2026-03-25 Wave 21): Automated dependency update pipeline. TD-28-02: Consolidated from root + .github/renovate.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":semanticCommits",
    ":automergeMinor",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": true,
  "schedule": ["after 3am and before 7am on Monday"],
  "commitMessagePrefix": "chore(deps):",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "manual-cooldown-override-required"],
    "automerge": false,
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates within existing version bounds",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Hold routine PyPI releases for a seven-day maturity window",
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "SHA-pin all GitHub Actions and auto-group weekly PRs",
      "matchDepTypes": ["action"],
      "pinDigests": true,
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "groupName": "GitHub Actions"
    },
    {
      "description": "MOD-2026-01: Pin all Docker images to SHA-256 digest for SLSA Level 2 immutable references",
      "matchManagers": ["docker-compose", "dockerfile"],
      "pinDigests": true,
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["security", "dependencies", "docker"]
    },
    {
      "description": "Keep security-sensitive Docker images on manual review schedule",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": [
        "ghcr.io/chrislusf/seaweedfs",
        "authzed/spicedb",
        "temporalio/server",
        "temporalio/ui"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["security", "dependencies"]
    },
    {
      "description": "RZ-22-02: Security-critical Python packages — manual review required (xz-utils attack vector)",
      "matchManagers": ["uv", "pep621", "pip_requirements"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "cryptography",
        "pyjwt",
        "bcrypt",
        "argon2-cffi",
        "pyotp",
        "webauthn",
        "python-jose"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["security", "manual-review-required"]
    },
    {
      "description": "Group Python dependency updates",
      "matchManagers": ["uv", "pep621", "pip_requirements"],
      "groupName": "python-deps",
      "groupSlug": "python-deps",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge patch updates for frontend npm packages",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "groupName": "Frontend patch updates"
    },
    {
      "description": "Group frontend non-major dependency updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend-deps",
      "groupSlug": "frontend-deps",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Track Go toolchain minor versions (manual review)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["go-toolchain", "dependencies"]
    },
    {
      "description": "MOD-06: Auto-merge Go module patch updates weekly",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "7 days",
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06: Group Go module minor/major updates for manual review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Go dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06: Auto-merge Rust (Cargo) patch updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Rust dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "7 days",
      "labels": ["rust", "dependencies"]
    },
    {
      "description": "MOD-06: Group Rust minor/major updates for manual review",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Rust dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["rust", "dependencies"]
    },
    {
      "description": "Keep custom workflow dependency updates reviewed and subject to a strict seven-day release-age check",
      "matchManagers": [
        "custom.regex"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false,
      "labels": [
        "dependencies",
        "manual-review-required"
      ]
    },
    {
      "description": "Keep setup-helm CLI updates on the tested Helm 4.2 line for Kubernetes 1.33",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "helm/helm"
      ],
      "allowedVersions": "<4.3.0",
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false,
      "labels": [
        "dependencies",
        "manual-review-required"
      ]
    },
    {
      "description": "Keep workflow Docker Hub image version and digest pairs on manual security review",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "pgvector/pgvector",
        "redis",
        "nats"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false,
      "labels": [
        "security",
        "dependencies",
        "docker",
        "manual-review-required"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the SQLMap workflow exact PyPI version pin",
      "managerFilePatterns": [
        "/^\\.github/workflows/sqlmap\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>uv pip install \"sqlmap==)(?<currentValue>\\d+\\.\\d+\\.\\d+)(?<suffix>\")"
      ],
      "depNameTemplate": "sqlmap",
      "packageNameTemplate": "sqlmap",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update the govulncheck go install release pin",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:reusable-security-audit|sbom)\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>(?:^|\\r?\\n)[ \\t]*(?:run:[ \\t]*)?go install golang\\.org/x/vuln/cmd/govulncheck@)(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?<suffix>[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "govulncheck",
      "packageNameTemplate": "golang/vuln",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update the osv-scanner release binary version and checksum together",
      "managerFilePatterns": [
        "/^\\.github/workflows/sbom\\.yml$/"
      ],
      "matchStrings": [
        "osv_scanner_version=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\" osv_scanner_sha256=\"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "osv-scanner",
      "packageNameTemplate": "google/osv-scanner",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the cargo-audit standalone Cargo CLI version",
      "managerFilePatterns": [
        "/^\\.github/workflows/sbom\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>(?:^|\\r?\\n)[ \\t]*(?:run:[ \\t]*)?cargo install cargo-audit --version[ \\t]+)(?<currentValue>\\d+\\.\\d+\\.\\d+)(?<suffix>[ \\t]+--locked[^\\r\\n]*(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "cargo-audit",
      "packageNameTemplate": "cargo-audit",
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update the golangci-lint CLI input to its SHA-pinned action",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:go-lint|reusable-go-tests)\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>(?:^|\\r?\\n)[ \\t]*uses:[ \\t]+golangci/golangci-lint-action@[^\\r\\n]*\\r?\\n[ \\t]+with:[ \\t]*\\r?\\n[ \\t]+version:[ \\t]*)(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?<suffix>[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "golangci-lint",
      "packageNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update tested Helm 4.2 CLI inputs to azure/setup-helm",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:ci|reusable-backend-tests|reusable-full-backend-mutation|reusable-helm-dependencies|reusable-security-audit)\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>(?:^|\\r?\\n)[ \\t]*uses:[ \\t]+azure/setup-helm@[^\\r\\n]*\\r?\\n[ \\t]+with:[ \\t]*\\r?\\n[ \\t]+version:[ \\t]*[\\\"']?)(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?<suffix>[\\\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "helm",
      "packageNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update Nuclei CLI input independently of its SHA-pinned action",
      "managerFilePatterns": [
        "/^\\.github/workflows/dast\\.yml$/"
      ],
      "matchStrings": [
        "(?<prefix>(?:^|\\r?\\n)[ \\t]*uses:[ \\t]+projectdiscovery/nuclei-action@[^\\r\\n]*\\r?\\n[ \\t]+with:[ \\t]*\\r?\\n[ \\t]+version:[ \\t]*)(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?<suffix>[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "nuclei",
      "packageNameTemplate": "projectdiscovery/nuclei",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{prefix}}}{{{newValue}}}{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update matched Docker Hub service image references with their tag and digest in workflow and test files",
      "managerFilePatterns": [
        "/^(?:\\.github/workflows/.*\\.ya?ml|tests/.*\\.py)$/"
      ],
      "matchStrings": [
        "(?<depName>pgvector/pgvector|redis|nats):(?<currentValue>[^\\s@\\\"']+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{#if newDigest}}{{{depName}}}:{{#if newValue}}{{{newValue}}}{{else}}{{{currentValue}}}{{/if}}@{{{newDigest}}}{{else}}{{{depName}}}:{{{currentValue}}}@{{{currentDigest}}}{{/if}}"
    }
  ]
}

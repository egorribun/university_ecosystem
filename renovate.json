{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "MOD-21-05 (audit 2026-03-25 Wave 21): Automated dependency update pipeline. TD-28-02: Consolidated from root + .github/renovate.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":semanticCommits",
    ":automergeMinor",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": true,
  "schedule": ["after 3am and before 7am on Monday"],
  "commitMessagePrefix": "chore(deps):",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates within existing version bounds",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Auto-merge security updates regardless of bump type",
      "matchCategories": ["security"],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "SHA-pin all GitHub Actions and auto-group weekly PRs",
      "matchDepTypes": ["action"],
      "pinDigests": true,
      "automerge": false,
      "groupName": "GitHub Actions"
    },
    {
      "description": "MOD-2026-01: Pin all Docker images to SHA-256 digest for SLSA Level 2 immutable references",
      "matchManagers": ["docker-compose", "dockerfile"],
      "pinDigests": true,
      "automerge": false,
      "labels": ["security", "dependencies", "docker"]
    },
    {
      "description": "Keep security-sensitive Docker images on manual review schedule",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": [
        "minio/minio",
        "authzed/spicedb",
        "temporalio/server",
        "temporalio/ui"
      ],
      "automerge": false,
      "labels": ["security", "dependencies"]
    },
    {
      "description": "RZ-22-02: Security-critical Python packages — manual review required (xz-utils attack vector)",
      "matchManagers": ["uv", "pep621", "pip_requirements"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "cryptography",
        "pyjwt",
        "bcrypt",
        "argon2-cffi",
        "pyotp",
        "webauthn",
        "python-jose"
      ],
      "automerge": false,
      "labels": ["security", "manual-review-required"]
    },
    {
      "description": "Group Python dependency updates",
      "matchManagers": ["uv", "pep621", "pip_requirements"],
      "groupName": "python-deps",
      "groupSlug": "python-deps"
    },
    {
      "description": "Auto-merge patch updates for frontend npm packages",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "groupName": "Frontend patch updates"
    },
    {
      "description": "Group frontend non-major dependency updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend-deps",
      "groupSlug": "frontend-deps"
    },
    {
      "description": "Track Go toolchain minor versions (manual review)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "automerge": false,
      "labels": ["go-toolchain", "dependencies"]
    },
    {
      "description": "MOD-06: Auto-merge Go module patch updates weekly",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06: Group Go module minor/major updates for manual review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Go dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["go", "dependencies"]
    },
    {
      "description": "MOD-06: Auto-merge Rust (Cargo) patch updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Rust dependencies (patch)",
      "schedule": ["every weekend"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["rust", "dependencies"]
    },
    {
      "description": "MOD-06: Group Rust minor/major updates for manual review",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "Rust dependencies (minor/major)",
      "schedule": ["every weekend"],
      "automerge": false,
      "labels": ["rust", "dependencies"]
    }
  ]
}

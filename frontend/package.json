.mjs tests/e2e-live/push-permission-denied.contract.test.mjs tests/e2e-live/email-otp-mfa-login.contract.test.mjs tests/e2e-live/map-zoom-longtask.contract.test.mjs tests/e2e-live/story-viewer-memory.contract.test.mjs tests/e2e-live/messenger-unread-read.contract.test.mjs tests/e2e-live/settings-password-change-rollback.contract.test.mjs tests/e2e-live/auth-login-lockout.contract.test.mjs tests/e2e-live/story-viewer-reduced-motion.contract.test.mjs tests/e2e-live/pwa-offline-shell-i18n.contract.test.mjs tests/e2e-live/ssr-hydration-i18n.contract.test.mjs tests/e2e-live/new-chat-hit-targets.contract.test.mjs tests/e2e-live/register-double-submit.contract.test.mjs tests/e2e-live/push-delivery.contract.test.mjs tests/e2e-live/admin-stories-rbac.contract.test.mjs tests/e2e-live/schedule-200-equivalent-reflow.contract.test.mjs tests/e2e-live/schedule-hydration-i18n.contract.test.mjs tests/e2e-live/navbar-layout-stability.contract.test.mjs tests/e2e-live/schedule-grid-keyboard.contract.test.mjs tests/e2e-live/settings-tabs-keyboard.contract.test.mjs tests/e2e-live/core-a11y-live.contract.test.mjs tests/e2e-live/news-responsive-matrix.contract.test.mjs tests/e2e-live/auth-roles.contract.test.mjs tests/e2e-live/live-ui-diagnostic.contract.test.mjs tests/e2e-live/http-status-diagnostic.contract.test.mjs tests/e2e-live/page-error-diagnostic.contract.test.mjs tests/e2e-live/messenger-realtime-live.contract.test.mjs tests/e2e-live/messenger-a11y-live.contract.test.mjs tests/e2e-live/admin-stories-smoke.contract.test.mjs tests/e2e-live/native-push-profile-cleanup.contract.test.mjs",

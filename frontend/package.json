{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "bin": {
    "google-chrome-stable": "./scripts/google-chrome-stable.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/run-build.mjs",
    "build:report": "npm run build -- --report",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 --ext .ts,.tsx \"src\" \"tests\"",
    "lint:all": "npm run lint && npm run manifests:check",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=vitest-report.xml",
    "test:watch": "vitest",
    "i18n:check": "vitest run src/tests/translationParity.test.ts",
    "test:e2e": "playwright test",
    "lhci": "node ./scripts/run-lhci.mjs",
    "analyze": "ANALYZE=1 vite build",
    "lint-staged": "lint-staged",
    "prepare": "husky ../.husky",
    "postinstall": "node ./scripts/setup-lhci-binaries.cjs",
    "generate:api": "node ./scripts/generate-api-types.mjs",
    "generate:manifests": "node ./scripts/generate-manifests.mjs",
    "generate:icons": "node ./scripts/generate-icons.js",
    "manifests:check": "node ./scripts/generate-manifests.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/x-date-pickers": "^6.19.0",
    "@noble/hashes": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/instrumentation-fetch": "^0.55.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-trace-web": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/react": "^10.20.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-virtual": "^3.13.13",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.7",
    "focus-trap": "^7.6.5",
    "framer-motion": "^12.23.13",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.553.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.1",
    "react-router-dom": "^7.12.0",
    "scrypt-js": "^3.0.1",
    "sharp": "^0.34.5",
    "web-vitals": "^4.2.4",
    "zod": "^3.24.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.12.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.50.1",
    "@sentry/vite-plugin": "^4.5.0",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-onboarding": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/trusted-types": "^2.0.7",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/browser": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-storybook": "^10.1.10",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.4.3",
    "msw": "^2.11.3",
    "openapi-typescript": "^7.5.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^10.1.10",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.12.1",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0",
    "workbox-build": "^7.3.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.3.0"
  },
  "description": "",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,scss,md,html}": [
      "prettier --check"
    ]
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": {
      "esbuild": "^0.25.0"
    },
    "tmp": "^0.2.4",
    "glob": "11.1.0"
  }
}

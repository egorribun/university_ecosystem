{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "bin": {
    "google-chrome-stable": "./scripts/google-chrome-stable.cjs"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-wasm.mjs",
    "dev": "vite",
    "build": "node ./scripts/build-orchestrated.mjs",
    "build:legacy": "node ./scripts/run-build.mjs",
    "build:shell": "node ./scripts/post-build-shell.mjs",
    "build:report": "npm run build -- --report",
    "preview": "vite preview",
    "start": "node ./scripts/server-prod.mjs",
    "lint": "eslint --max-warnings=0 --ext .ts,.tsx \"src\" \"tests\"",
    "lint:deadcode": "ts-prune",
    "lint:depcheck": "node scripts/lint-depcheck.mjs",
    "lint:all": "npm run lint && npm run manifests:check && npm run tokens:sync && npm run lint:deadcode && npm run lint:depcheck",
    "lint:fix": "npm run lint -- --fix",
    "tokens:sync": "node ./scripts/sync-tokens.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:ci": "npm run test:wasm && vitest run --configLoader runner --coverage --reporter=default --reporter=junit --outputFile=vitest-report.xml",
    "test:client-production": "vitest run --configLoader runner --mode production src/api/__tests__/client.csrf.production.test.ts --silent=true --maxWorkers=1 --minWorkers=1",
    "test:mutation": "stryker run",
    "test:wasm-artifacts": "node --test scripts/verify-wasm-artifacts.test.mjs",
    "test:wasm": "node --test scripts/verify-wasm-artifacts.test.mjs scripts/build-wasm.test.mjs scripts/wasm-runtime-smoke.test.mjs scripts/merge-vitest-coverage.test.mjs scripts/build-orchestrated.contract.test.mjs",
    "test:watch": "vitest --configLoader runner",
    "i18n:check": "vitest run --configLoader runner src/tests/translationParity.test.ts",
    "test:e2e": "playwright test",
    "visual:smoke": "node ./scripts/playwright-visual-smoke.mjs",
    "lhci": "node ./scripts/run-lhci.mjs",
    "lhci:windows": "node ./scripts/lhci-windows-fallback.mjs",
    "analyze": "ANALYZE=1 vite build",
    "lint-staged": "lint-staged",
    "prepare": "node ./scripts/setup-husky.cjs",
    "postinstall": "node ./scripts/setup-lhci-binaries.cjs",
    "generate:api": "openapi-ts && msw-auto-mock ./openapi.json -o src/tests/mocks/generated --typescript",
    "generate:manifests": "node ./scripts/generate-manifests.mjs",
    "generate:icons": "node ./scripts/generate-icons.js",
    "manifests:check": "node ./scripts/generate-manifests.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",

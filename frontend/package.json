    "lint:architecture": "node --test scripts/eslint-architecture.test.mjs scripts/ui-barrel-boundary.test.mjs scripts/boundary-micromatch-compat.test.mjs",
    "lint:knip": "knip --reporter compact --no-progress",
    "lint:all": "npm run lint && npm run lint:architecture && npm run manifests:check && npm run tokens:check && npm run tokens:sync && npm run lint:knip",
    "lint:fix": "npm run lint -- --fix",
    "tokens:sync": "node ./scripts/sync-tokens.mjs",
    "tokens:check": "node ./scripts/validate-css-token-closure.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"tests/**/*.{ts,tsx,js,jsx}\" vite.config.mts playwright.config.ts vitest.config.ts tsconfig.json pwa-maskable-icons.ts \"scripts/**/*.mjs\"",

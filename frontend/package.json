    "framer-motion": "^12.23.13",
    "html-to-image": "^1.11.13",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "idb-keyval": "^6.2.2",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.553.0",
    "maplibre-gl": "^5.22.0",
    "marked": "^17.0.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.0.1",
    "react-map-gl": "^8.1.1",
    "rxdb": "^17.4.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.4.0",
